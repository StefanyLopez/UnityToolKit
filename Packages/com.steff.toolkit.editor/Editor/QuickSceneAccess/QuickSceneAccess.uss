/* Quick Scene Access
   Theme-dependent colors are variables defined on .qsa--dark / .qsa--light
   (the window adds one of them to its root). Everything else uses Unity's
   native controls and fonts. */

.qsa {
    flex-grow: 1;
}

.qsa--dark {
    --qsa-dim: rgba(255, 255, 255, 0.5);
    --qsa-hover: rgba(255, 255, 255, 0.07);
    --qsa-active-bg: rgba(60, 110, 165, 0.45);
    --qsa-accent: rgb(90, 165, 255);
    --qsa-divider: rgba(255, 255, 255, 0.1);
    --qsa-chip-bg: rgba(255, 255, 255, 0.1);
    --qsa-star-on: rgb(240, 190, 60);
}

.qsa--light {
    --qsa-dim: rgba(0, 0, 0, 0.5);
    --qsa-hover: rgba(0, 0, 0, 0.06);
    --qsa-active-bg: rgba(60, 120, 190, 0.22);
    --qsa-accent: rgb(30, 90, 185);
    --qsa-divider: rgba(0, 0, 0, 0.15);
    --qsa-chip-bg: rgba(0, 0, 0, 0.08);
    --qsa-star-on: rgb(195, 135, 0);
}

/* Toolbar */

.qsa-toolbar {
    padding: 0 2px;
}

.qsa-search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 80px;
    margin: 2px 4px;
}

/* Banner */

.qsa-banner {
    margin: 4px 6px 0 6px;
}

/* List area */

.qsa-body {
    flex-grow: 1;
}

.qsa-list {
    flex-grow: 1;
}

.qsa-row {
    flex-grow: 1;
}

/* Header rows */

.qsa-row__header {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    padding: 0 10px 3px 10px;
}

.qsa-row__header-label {
    flex-grow: 1;
    padding: 0;
    margin: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--qsa-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.qsa-row__header-count {
    padding: 0;
    margin: 0 0 0 6px;
    font-size: 11px;
    color: var(--qsa-dim);
}

/* Scene rows */

.qsa-row__scene {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 6px 0 7px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.qsa-row__scene:hover {
    background-color: var(--qsa-hover);
}

.qsa-row--active,
.qsa-row--active:hover {
    background-color: var(--qsa-active-bg);
    border-left-color: var(--qsa-accent);
}

.qsa-row--active .qsa-row__name {
    -unity-font-style: bold;
}

.qsa-row--locked {
    opacity: 0.5;
}

.qsa-row__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
}

.qsa-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.qsa-row__name {
    margin: 0;
    padding: 0;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.qsa-row__path {
    margin: 1px 0 0 0;
    padding: 0;
    font-size: 10px;
    color: var(--qsa-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.qsa-chip {
    flex-shrink: 0;
    height: 14px;
    margin: 0 0 0 4px;
    padding: 0 5px;
    font-size: 10px;
    border-radius: 3px;
    background-color: var(--qsa-chip-bg);
    color: var(--qsa-dim);
    -unity-text-align: middle-center;
}

.qsa-chip--accent {
    color: var(--qsa-accent);
}

.qsa-row__star {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 14px;
    color: var(--qsa-dim);
    opacity: 0;
    -unity-text-align: middle-center;
}

.qsa-row__scene:hover .qsa-row__star {
    opacity: 1;
}

.qsa-row__star--on,
.qsa-row__scene:hover .qsa-row__star--on {
    opacity: 1;
    color: var(--qsa-star-on);
}

/* Empty state */

.qsa-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.qsa-empty__title {
    margin: 0 0 4px 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.qsa-empty__message {
    margin: 0;
    color: var(--qsa-dim);
    -unity-text-align: upper-center;
    white-space: normal;
}

/* Status bar */

.qsa-status {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 6px 0 10px;
    border-top-width: 1px;
    border-top-color: var(--qsa-divider);
}

.qsa-status__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--qsa-dim);
}

.qsa-status__button {
    height: 18px;
    margin: 0;
    padding: 0 8px;
    font-size: 11px;
}
